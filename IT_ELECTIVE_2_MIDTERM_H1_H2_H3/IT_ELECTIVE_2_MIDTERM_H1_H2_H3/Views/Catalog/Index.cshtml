@model IEnumerable<IT_ELECTIVE_2_MIDTERM_H1_H2_H3.Models.Entities.Product>
@{
    ViewData["Title"] = "Product Catalog";
}

<h2 class="mb-4">Tech Hardware Catalog</h2>

<div class="row row-cols-1 row-cols-md-4 g-4">
    @foreach (var product in Model)
    {
        bool isOutOfStock = product.StockQuantity <= 0;

        <div class="col">
            <div class="card h-100 shadow-sm @(isOutOfStock ? "bg-light text-muted opacity-75" : "")">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@product.Name</h5>
                    <p class="card-text text-primary fw-bold fs-5">$@product.Price.ToString("F2")</p>

                    <p class="card-text">
                        @if (isOutOfStock)
                        {
                            <span class="badge bg-danger">Out of Stock</span>
                        }
                        else
                        {
                            <span class="badge bg-success">In Stock: @product.StockQuantity</span>
                        }
                    </p>

                    <div class="mt-auto">
                        <form asp-controller="Cart" asp-action="AddToCart" method="post">
                            <input type="hidden" name="ProductId" value="@product.Id" />
                            <div class="input-group mb-2">
                                <input type="number" name="Quantity" value="1" min="1" max="@product.StockQuantity" class="form-control" @(isOutOfStock ? "disabled" : "") />
                                <button type="submit" class="btn btn-primary" @(isOutOfStock ? "disabled" : "")>Add</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>