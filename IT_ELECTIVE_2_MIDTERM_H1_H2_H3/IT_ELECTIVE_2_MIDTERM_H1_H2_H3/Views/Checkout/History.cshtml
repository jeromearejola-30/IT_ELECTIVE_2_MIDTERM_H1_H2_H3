@model List<IT_ELECTIVE_2_MIDTERM_H1_H2_H3.Models.Entities.Order>
@{
    ViewData["Title"] = "Transaction History";
}

<h2 class="mb-4">Transaction History</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">No transactions recorded yet.</div>
}
else
{
    <table class="table table-striped table-hover align-middle shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Transaction ID</th>
                <th>Date</th>
                <th>Customer Name</th>
                <th>Grand Total</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var transaction in Model)
            {
                <tr>
                    <td><strong>#@transaction.OrderId</strong></td>
                    <td>@transaction.OrderDate.ToString("g")</td>
                    <td>@transaction.CustomerName</td>
                    <td class="text-success fw-bold">$@transaction.TotalAmount.ToString("F2")</td>
                    <td>
                        <a asp-controller="Checkout" asp-action="Confirmation" asp-route-orderId="@transaction.OrderId" class="btn btn-sm btn-outline-primary">View Details</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}