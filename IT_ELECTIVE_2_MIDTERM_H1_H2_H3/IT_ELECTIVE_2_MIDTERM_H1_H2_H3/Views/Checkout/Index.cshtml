@model IT_ELECTIVE_2_MIDTERM_H1_H2_H3.Models.DTOs.CheckoutDTO
@{
    ViewData["Title"] = "Checkout";
    var cart = ViewBag.Cart as IT_ELECTIVE_2_MIDTERM_H1_H2_H3.Models.Entities.ShoppingCart;
}

<h2 class="mb-4">Checkout</h2>

<div class="row">
    <!-- Left Column: Order Summary -->
    <div class="col-md-5 order-md-2 mb-4">
        <div class="card shadow-sm">
            <div class="card-header bg-dark text-white">
                <h5 class="my-0">Order Summary</h5>
            </div>
            <div class="card-body">
                @if (cart != null && cart.Items.Any())
                {
                    <ul class="list-group list-group-flush mb-3">
                        @foreach (var item in cart.Items)
                        {
                            <li class="list-group-item d-flex justify-content-between lh-sm px-0">
                                <div>
                                    <h6 class="my-0">@item.Product.Name</h6>
                                    <small class="text-muted">Qty: @item.Quantity × $@item.Product.Price.ToString("F2")</small>
                                </div>
                                <span class="text-muted">$@((item.Product.Price * item.Quantity).ToString("F2"))</span>
                            </li>
                        }
                    </ul>
                    <div class="d-flex justify-content-between fw-bold fs-5 border-top pt-2">
                        <span>Total:</span>
                        <span class="text-success">$@cart.GrandTotal.ToString("F2")</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Right Column: Checkout Form -->
    <div class="col-md-7 order-md-1">
        <form asp-controller="Checkout" asp-action="Index" method="post" class="needs-validation">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="CustomerName" class="form-label">Customer Name *</label>
                <input asp-for="CustomerName" class="form-control" />
                <span asp-validation-for="CustomerName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email (Optional)</label>
                <input asp-for="Email" class="form-control" placeholder="customer@example.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ShippingAddress" class="form-label">Shipping / Billing Address *</label>
                <textarea asp-for="ShippingAddress" class="form-control" rows="3"></textarea>
                <span asp-validation-for="ShippingAddress" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PaymentMethod" class="form-label">Payment Method *</label>
                <select asp-for="PaymentMethod" class="form-select">
                    <option value="">-- Select Payment Method --</option>
                    <option value="Cash">Cash</option>
                    <option value="Credit Card">Credit Card</option>
                    <option value="E-Wallet">E-Wallet</option>
                </select>
                <span asp-validation-for="PaymentMethod" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary btn-lg w-100 mt-3">Complete Order</button>
        </form>
    </div>
</div>